# URL pública del sitio (metadatos / Open Graph). En Vercel: tu dominio final.
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# Correo que recibe peticiones de oración, solicitudes de grupo, etc.
NEXT_PUBLIC_CONTACT_EMAIL=hola@tu-dominio.com

# WhatsApp de la iglesia: solo dígitos con lada de país, ej. 5214421234567.
# Sin este valor el pie de página muestra un aviso en lugar del botón.
NEXT_PUBLIC_WHATSAPP_NUMBER=
